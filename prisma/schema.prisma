generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  RENTER
  LANDLORD
  ADMIN
}
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?  @unique
  password  String

  dateOfBirth DateTime?
  role        Role @default(RENTER)

  otpCode    String?
  otpExpires DateTime?
}
